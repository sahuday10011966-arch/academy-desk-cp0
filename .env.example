# MongoDB database dedicated to Academy Desk. Use a development database locally.
MONGODB_URI=

# At least 32 random characters. Keep this value server-side and separate by environment.
AUTH_SECRET=

# Demo seeding is disabled unless explicitly enabled. Never point it at production data.
ALLOW_DEMO_SEED=false
DEMO_DB_NAME=academy_desk_demo
DEMO_COACH_EMAIL=
DEMO_COACH_PASSWORD=
DEMO_SCOUT_EMAIL=
DEMO_SCOUT_PASSWORD=
DEMO_PLAYER_EMAIL=
DEMO_PLAYER_PASSWORD=
